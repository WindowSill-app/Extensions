<?xml version="1.0" encoding="utf-8" ?>
<api:SillPopupContent
    x:Class="WindowSill.FileHelper.Views.ZipDetailsPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="using:WindowSill.API"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowSill.FileHelper.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WindowSill.FileHelper.ViewModels"
    Width="460"
    Height="460"
    mc:Ignorable="d">

    <api:SillPopupContent.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter
            x:Key="TrueToCollapsedConverter"
            FalseValue="Visible"
            TrueValue="Collapsed" />
    </api:SillPopupContent.Resources>

    <!--
        The list fills the whole popup and its top padding leaves room for the header, so entries scroll UP behind
        the acrylic header (which is drawn on top). The header shrinks and its detail lines fade as the list scrolls;
        the collapse is driven from the inner ScrollViewer in code-behind. See ZipDetailsPopup.xaml.cs.
    -->
    <Grid>
        <!--  Entries (largest-first) — sits behind the header and scrolls under it.  -->
        <ListView
            x:Name="EntriesList"
            Padding="12,96,12,12"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.HasEntries, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:ZipEntryListItemViewModel">
                    <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind RelativePath}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind Name}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />

                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Spacing="0">
                            <TextBlock
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind SizesText}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Foreground="{x:Bind local:ZipDetailsPopup.OutcomeBrush(IsSmaller, IsLarger)}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind CompressionText}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Loading  -->
        <StackPanel
            Padding="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                api:Uids.Uid="/WindowSill.FileHelper/ZipInfo/Loading"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!--  Empty archive  -->
        <TextBlock
            Margin="20,96,20,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            api:Uids.Uid="/WindowSill.FileHelper/ZipInfo/EmptyArchive"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Border
            x:Name="HeaderBorder"
            Height="96"
            VerticalAlignment="Top"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Rectangle Fill="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />

                <StackPanel
                    Padding="20,12,20,0"
                    VerticalAlignment="Top"
                    Spacing="4">
                    <TextBlock
                        AutomationProperties.Name="{x:Bind ViewModel.FileName}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.FileName}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />

                    <!--  Detail lines that fade out as the header collapses.  -->
                    <StackPanel x:Name="HeaderDetails" Spacing="4">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{x:Bind local:ZipDetailsPopup.OutcomeBrush(ViewModel.IsSmaller, ViewModel.IsLarger), Mode=OneWay}"
                            Text="{x:Bind ViewModel.CompressionRatioText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource TrueToCollapsedConverter}}">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.CountsText, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.SizesText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</api:SillPopupContent>
