<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowSill.FileHelper.Views.ConvertDocumentPopupProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="using:WindowSill.API"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:WindowSill.FileHelper.Services"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Task List  -->
        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollMode="Disabled"
            VerticalScrollMode="Auto">
            <ItemsControl
                Margin="24"
                AutomationProperties.AutomationId="ConvertDocumentTaskList"
                ItemsSource="{x:Bind ViewModel.Queue.Tasks, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:FileOperationTaskItem">
                        <Grid Margin="0,0,0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--
                                Status Indicator.
                                Each InfoBadge is self-contained (inline ThemeResource brush + IconSource) rather
                                than depending on a named host-app Style resource such as "CautionIconInfoBadgeStyle",
                                which does not exist and previously crashed the page the instant a task row was
                                realized (i.e. immediately after clicking "Start conversion").
                            -->
                            <Grid
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center">
                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    IsActive="{x:Bind IsRunning, Mode=OneWay}" />
                                <InfoBadge Background="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind IsSucceeded, Mode=OneWay}">
                                    <InfoBadge.IconSource>
                                        <FontIconSource FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE73E;" />
                                    </InfoBadge.IconSource>
                                </InfoBadge>
                                <InfoBadge Background="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind IsFailed, Mode=OneWay}">
                                    <InfoBadge.IconSource>
                                        <FontIconSource FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE783;" />
                                    </InfoBadge.IconSource>
                                </InfoBadge>
                                <InfoBadge Background="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind IsCanceled, Mode=OneWay}">
                                    <InfoBadge.IconSource>
                                        <FontIconSource FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" Glyph="&#xE711;" />
                                    </InfoBadge.IconSource>
                                </InfoBadge>
                            </Grid>

                            <!--  File Name  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                AutomationProperties.Name="{x:Bind FileName}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind FileName}"
                                TextTrimming="CharacterEllipsis" />

                            <!--  Progress Bar  -->
                            <ProgressBar
                                Grid.Row="1"
                                Grid.Column="1"
                                Maximum="1"
                                Minimum="0"
                                Visibility="{x:Bind IsRunning, Mode=OneWay}"
                                Value="{x:Bind Progress, Mode=OneWay}" />

                            <!--  Per-file failure reason: shown only for failed tasks, instead of a silent/inert failure  -->
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                AutomationProperties.Name="{x:Bind ErrorMessage, Mode=OneWay}"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ErrorMessage, Mode=OneWay}"
                                Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  Bottom Bar with Cancel Button  -->
        <Border
            Grid.Row="1"
            Padding="24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            XYFocusKeyboardNavigation="Enabled">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="1"
                    api:Uids.Uid="/WindowSill.FileHelper/ConvertDocument/CancelButton"
                    AutomationProperties.AutomationId="ConvertDocumentCancelButton"
                    Command="{x:Bind ViewModel.CancelConversionCommand}"
                    ElementSoundMode="FocusOnly"
                    Style="{ThemeResource LargeButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
