<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowSill.FileHelper.Views.ExtractPagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="using:WindowSill.API"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WindowSill.FileHelper.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="24,24,24,8"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                AutomationProperties.AutomationId="ExtractSelectAll"
                api:Uids.Uid="/WindowSill.FileHelper/PdfActions/SelectAll"
                Command="{x:Bind ViewModel.SelectAllCommand}" />
            <Button
                AutomationProperties.AutomationId="ExtractClear"
                api:Uids.Uid="/WindowSill.FileHelper/PdfActions/ClearSelection"
                Command="{x:Bind ViewModel.ClearSelectionCommand}" />
        </StackPanel>

        <ProgressRing
            Grid.Row="1"
            Width="32"
            Height="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            x:Name="LoadingRing"
            IsActive="True" />

        <TextBlock
            Grid.Row="1"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            api:Uids.Uid="/WindowSill.FileHelper/PdfActions/PreviewUnavailable"
            TextAlignment="Center"
            TextWrapping="Wrap"
            x:Name="PreviewUnavailableText"
            Visibility="Collapsed" />

        <!--  ItemsRepeater virtualizes the grid, so only pages scrolled into view are ever rasterized.  -->
        <ScrollViewer
            Grid.Row="1"
            x:Name="PagesScroller"

            MinHeight="300"

            Visibility="Collapsed"
            Padding="24,0,24,16"
            HorizontalScrollMode="Disabled"
            VerticalScrollMode="Auto">
            <ItemsRepeater x:Name="PagesRepeater" ItemsSource="{x:Bind ViewModel.Pages}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="None"
                        MinColumnSpacing="12"
                        MinItemWidth="118"
                        MinRowSpacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:PdfPageItemViewModel">
                        <StackPanel Width="110" Spacing="4">
                            <!--
                                The whole thumbnail is the toggle, so picking pages does not mean aiming at a small
                                checkbox. Using a ToggleButton rather than a tap handler keeps keyboard and
                                screen-reader support; the checkbox is left purely as the state indicator.
                            -->
                            <ToggleButton
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                BorderThickness="0"
                                CornerRadius="0"
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                                <Grid>
                                    <Border
                                        Height="{x:Bind ThumbnailHeight}"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                    </Border>
                                    <CheckBox
                                        Margin="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        AutomationProperties.AccessibilityView="Raw"
                                        IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                        IsHitTestVisible="False"
                                        IsTabStop="False" />
                                </Grid>
                            </ToggleButton>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind PageNumber}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="24"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <api:ShortcutButton
                AutomationProperties.AutomationId="ExtractConfirm"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.ConfirmCommand}"
                Content="{x:Bind ViewModel.ConfirmText, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanConfirm, Mode=OneWay}"
                Style="{StaticResource LargeShortcutButtonStyle}" />
        </Border>
    </Grid>
</Page>
