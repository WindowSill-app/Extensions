<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowSill.FileHelper.Views.PdfPasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="using:WindowSill.API"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="24"
            VerticalAlignment="Top"
            Spacing="12">
            <TextBlock
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.Hint}"
                TextWrapping="Wrap" />
            <PasswordBox
                x:Name="PasswordEntry"
                AutomationProperties.AutomationId="PdfPasswordBox"
                Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                PasswordChanged="PasswordEntry_PasswordChanged" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="24"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <api:ShortcutButton
                AutomationProperties.AutomationId="PdfPasswordConfirm"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.ConfirmCommand}"
                Content="{x:Bind ViewModel.ConfirmText}"
                IsEnabled="{x:Bind ViewModel.CanConfirm, Mode=OneWay}"
                Style="{StaticResource LargeShortcutButtonStyle}" />
        </Border>
    </Grid>
</Page>
