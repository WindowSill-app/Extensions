<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowSill.FileHelper.Views.MergeOrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="using:WindowSill.API"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WindowSill.FileHelper.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="24,24,24,8"
            api:Uids.Uid="/WindowSill.FileHelper/PdfActions/MergeOrderHint"
            Style="{ThemeResource BodyStrongTextBlockStyle}"
            TextWrapping="Wrap" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollMode="Disabled"
            VerticalScrollMode="Auto">
            <ItemsControl
                Margin="24,0,24,16"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.Files}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:MergeFileViewModel">
                        <Border
                            Padding="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Position, Mode=OneWay}" />

                                <Border
                                    Grid.Column="1"
                                    Width="48"
                                    Height="62"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock
                                        MaxLines="2"
                                        Text="{x:Bind FileName}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind PageCountText, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Spacing="4">
                                    <Button
                                        AutomationProperties.AutomationId="MergeMoveUp"
                                        api:Uids.Uid="/WindowSill.FileHelper/PdfActions/MoveUp"
                                        Command="{x:Bind MoveUpCommand}"
                                        CommandParameter="{x:Bind}"
                                        IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}">
                                        <FontIcon FontSize="12" Glyph="&#xE70E;" />
                                    </Button>
                                    <Button
                                        AutomationProperties.AutomationId="MergeMoveDown"
                                        api:Uids.Uid="/WindowSill.FileHelper/PdfActions/MoveDown"
                                        Command="{x:Bind MoveDownCommand}"
                                        CommandParameter="{x:Bind}"
                                        IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}">
                                        <FontIcon FontSize="12" Glyph="&#xE70D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="24"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <api:ShortcutButton
                AutomationProperties.AutomationId="MergeConfirm"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.ConfirmCommand}"
                Content="{x:Bind ViewModel.ConfirmText}"
                Style="{StaticResource LargeShortcutButtonStyle}" />
        </Border>
    </Grid>
</Page>
