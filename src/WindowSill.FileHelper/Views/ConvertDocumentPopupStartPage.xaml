<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WindowSill.FileHelper.Views.ConvertDocumentPopupStartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="using:WindowSill.API"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:WindowSill.FileHelper.ViewModels"
    mc:Ignorable="d">

    <!--
        The selection reads as the popup's title, with the action cards directly beneath it, both anchored to the
        top. The cards are laid out two per row, matching how ImageHelper and VideoHelper present their format
        choices.
    -->
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollMode="Disabled"
        VerticalScrollMode="Auto">
        <StackPanel
            Margin="24"
            VerticalAlignment="Top"
            Spacing="12">
            <TextBlock
                MaxLines="1"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.SelectionSummary}"
                TextTrimming="CharacterEllipsis" />

            <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Actions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:UniformGrid
                            VerticalAlignment="Top"
                            ColumnSpacing="8"
                            Columns="2"
                            RowSpacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:FileActionViewModel">
                        <api:ShortcutButton
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="{x:Bind AutomationId}"
                            Command="{x:Bind Command}"
                            Style="{StaticResource LargeShortcutButtonStyle}">
                            <!--  The button's height is fixed by the style, so a long label is trimmed rather than wrapped out of view.  -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{x:Bind DisplayName}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                        </api:ShortcutButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
